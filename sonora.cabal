cabal-version:      3.0
name:               sonora
version:            0.1.0.0
synopsis:           Functional music synthesis and composition engine
description:        A pure functional music synthesis, DSP, and composition engine written in Haskell.
license:            MIT
author:             Sonora Team
maintainer:         sonora@example.com
category:           Sound, Music, DSP
build-type:         Simple
extra-doc-files:    README.md

common common-options
    default-language:   Haskell2010
    default-extensions:
        BangPatterns
        DeriveFunctor
        DeriveGeneric
        FlexibleContexts
        GeneralizedNewtypeDeriving
        OverloadedStrings
        RecordWildCards
        ScopedTypeVariables
        TupleSections
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -O2

library
    import:             common-options
    hs-source-dirs:     src
    exposed-modules:
        Sonora
        Sonora.Music.Pitch
        Sonora.Music.Interval
        Sonora.Music.Duration
        Sonora.Music.Note
        Sonora.Music.Scale
        Sonora.Music.Chord
        Sonora.Music.Composition
        Sonora.Signal.Core
        Sonora.Signal.Oscillator
        Sonora.Signal.Envelope
        Sonora.Signal.Filter
        Sonora.Signal.Effects
        Sonora.Synth.Voice
        Sonora.Synth.Instrument
        Sonora.Synth.Synthesizer
        Sonora.Render.WAV
        Sonora.Render.Engine
        Sonora.DSL.AST
        Sonora.DSL.Lexer
        Sonora.DSL.Parser
        Sonora.DSL.Evaluator
        Sonora.Generate.Random
        Sonora.Generate.Melody
        Sonora.Generate.Progression
        Sonora.Generate.Procedural
        Sonora.Synth.Patch
        Sonora.Project.Types
        Sonora.Project.Score
        Sonora.Project.Update
        Sonora.Project.Compile
        Sonora.Audio.Backend
        Sonora.Audio.Mixer
        Sonora.Audio.Device
        Sonora.Audio.Fake
        Sonora.Service.Protocol
        Sonora.Service.Server
        Sonora.Service.Methods
    -- Audio device access: WASAPI through direct FFI to Windows system DLLs.
    if os(windows)
        other-modules:   Sonora.Audio.Wasapi
        extra-libraries: ole32
    build-depends:
        base >= 4.14 && < 5,
        aeson >= 2.0 && < 2.3,
        binary >= 0.8,
        bytestring >= 0.10,
        containers >= 0.6,
        deepseq >= 1.4,
        directory >= 1.3,
        filepath >= 1.4,
        mtl >= 2.2,
        parsec >= 3.1,
        process >= 1.6,
        text >= 1.2,
        vector >= 0.12

executable sonora
    import:             common-options
    main-is:            Main.hs
    hs-source-dirs:     app
    build-depends:
        base,
        sonora,
        bytestring,
        directory,
        filepath,
        optparse-applicative >= 0.16,
        parsec >= 3.1,
        process,
        text,
        vector
    ghc-options:
        -rtsopts
        -threaded
        "-with-rtsopts=-N"

executable sonora-service
    import:             common-options
    main-is:            Main.hs
    hs-source-dirs:     service
    other-modules:      Paths_sonora
    autogen-modules:    Paths_sonora
    build-depends:
        base,
        sonora,
        containers,
        optparse-applicative >= 0.16,
        text
    ghc-options:
        -rtsopts
        -threaded
        "-with-rtsopts=-N"

test-suite sonora-test
    import:             common-options
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    hs-source-dirs:     test
    other-modules:
        MusicSpec
        SignalSpec
        ParserSpec
        DeterminismSpec
        AudioSpec
        ServiceSpec
        ProjectSpec
    build-tool-depends:
        sonora:sonora-service
    build-depends:
        base,
        sonora,
        aeson,
        bytestring,
        containers,
        directory,
        process,
        QuickCheck >= 2.14,
        text,
        vector
    ghc-options:
        -threaded
